{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "judge_kind": {
      "type": "string",
      "enum": ["semantic", "code_quality"]
    },
    "set_kind": {
      "type": "string",
      "enum": ["locked_admission", "locked_bias"]
    },
    "freeze_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "judge_definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repeats_per_case": {
      "type": "number",
      "const": 3
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "judge_kind",
    "set_kind",
    "freeze_receipt_sha256",
    "judge_definition_sha256",
    "input_set_sha256",
    "repeats_per_case",
    "created_at"
  ],
  "additionalProperties": false,
  "$id": "https://dsh-eval-lab.local/contracts/phase3c/judge-execution-manifest.schema.json"
}
