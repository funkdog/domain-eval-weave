{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "judge_kind": {
      "type": "string",
      "const": "semantic"
    },
    "judge_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_receipts": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["ref", "sha256"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["ref", "sha256"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["ref", "sha256"],
          "additionalProperties": false
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "repeat_results": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["ref", "sha256"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["ref", "sha256"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["ref", "sha256"],
          "additionalProperties": false
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "dimensions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension_id": {
            "type": "string",
            "enum": [
              "requirement_intent_alignment",
              "architecture_fit",
              "failure_semantics_coherence",
              "handoff_comprehensibility"
            ]
          },
          "applicability": {
            "type": "string",
            "enum": ["applicable", "not_applicable"]
          },
          "verdict": {
            "type": "string",
            "enum": ["pass", "fail", "abstain"]
          },
          "severity": {
            "type": "string",
            "enum": ["blocking", "concern", "none"]
          },
          "matched_condition_ids": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_ref": {
                  "type": "string",
                  "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": ["source_ref", "locator"],
              "additionalProperties": false
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "counterevidence": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "abstention_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "insufficient_evidence",
                  "conflicting_authority",
                  "rubric_not_applicable",
                  "out_of_distribution",
                  "unsafe_or_untrusted_instruction",
                  "unstable_across_repeats"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "dimension_id",
          "applicability",
          "verdict",
          "severity",
          "matched_condition_ids",
          "evidence",
          "rationale",
          "counterevidence",
          "abstention_reason"
        ],
        "additionalProperties": false
      }
    },
    "protocol_status": {
      "type": "string",
      "enum": ["valid", "invalid"]
    }
  },
  "required": [
    "schema_version",
    "judge_kind",
    "judge_contract_sha256",
    "input_manifest_sha256",
    "run_receipts",
    "repeat_results",
    "dimensions",
    "protocol_status"
  ],
  "additionalProperties": false,
  "$id": "https://dsh-eval-lab.local/contracts/phase3c/semantic-judge-result.schema.json"
}
