{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "candidate_archive": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["ref", "sha256"],
      "additionalProperties": false
    },
    "candidate_diff": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["ref", "sha256"],
      "additionalProperties": false
    },
    "base_tree": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["ref", "sha256"],
      "additionalProperties": false
    },
    "public_task": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["ref", "sha256"],
      "additionalProperties": false
    },
    "untrusted_candidate_content": {
      "type": "boolean",
      "const": true
    },
    "judge_kind": {
      "type": "string",
      "const": "semantic"
    },
    "requirement": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["ref", "sha256"],
      "additionalProperties": false
    },
    "domain_refs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": ["ref", "sha256"],
        "additionalProperties": false
      }
    },
    "semantic_residual_claim_ids": {
      "minItems": 0,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "judge_contract": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["ref", "sha256"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "candidate_archive",
    "candidate_diff",
    "base_tree",
    "public_task",
    "untrusted_candidate_content",
    "judge_kind",
    "requirement",
    "domain_refs",
    "semantic_residual_claim_ids",
    "judge_contract"
  ],
  "additionalProperties": false,
  "$id": "https://dsh-eval-lab.local/contracts/phase3c/semantic-judge-input-manifest.schema.json"
}
