{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-eval-lab.local/contracts/experiment.schema.json",
  "title": "DSH Eval Lab ExperimentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "created_at",
    "domain",
    "eval_pack_id",
    "task_pack_digest",
    "control_variant_digest",
    "treatment_variant_digest",
    "deployment",
    "intervention",
    "arm_order",
    "timeout_ms_per_arm",
    "claim_strength",
    "effect_claim_eligible"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "campaign_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "domain": { "const": "open-coding-delivery" },
    "eval_pack_id": { "const": "open-coding-delivery-v1" },
    "task_pack_digest": { "$ref": "#/$defs/sha256" },
    "control_variant_digest": { "$ref": "#/$defs/sha256" },
    "treatment_variant_digest": { "$ref": "#/$defs/sha256" },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "eval_package_sha256", "qualification", "calibration"],
      "properties": {
        "digest": { "$ref": "#/$defs/sha256" },
        "eval_package_sha256": { "$ref": "#/$defs/sha256" },
        "qualification": { "$ref": "#/$defs/qualificationEvidence" },
        "qualification_projection": { "$ref": "#/$defs/qualificationProjection" },
        "calibration": { "$ref": "#/$defs/calibrationEvidence" }
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "allowed_config_paths"],
      "properties": {
        "id": { "const": "dsh-goal-stack" },
        "allowed_config_paths": {
          "type": "array",
          "prefixItems": [
            { "const": "goal.disabled" },
            { "const": "goal-round-driver.disabled" },
            { "const": "command-goal.disabled" },
            { "const": "tool-goal.disabled" }
          ],
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "arm_order": {
      "type": "array",
      "items": { "enum": ["control", "treatment"] },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "timeout_ms_per_arm": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5400000
    },
    "claim_strength": { "const": "diagnostic" },
    "effect_claim_eligible": { "const": false }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ready",
        "deployment_digest",
        "session_id",
        "common_tool_schema_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "ready": { "const": true },
        "deployment_digest": { "$ref": "#/$defs/sha256" },
        "session_id": { "$ref": "#/$defs/id" },
        "common_tool_schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "qualificationProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_deployment_digest",
        "projected_deployment_digest",
        "source_qualification_sha256"
      ],
      "properties": {
        "source_deployment_digest": { "$ref": "#/$defs/sha256" },
        "projected_deployment_digest": { "$ref": "#/$defs/sha256" },
        "source_qualification_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "calibrationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ready",
        "task_pack_digest",
        "calibration_digest",
        "eval_package_sha256",
        "candidates",
        "repeatable",
        "seed_stable"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "ready": { "const": true },
        "task_pack_digest": { "$ref": "#/$defs/sha256" },
        "calibration_digest": { "$ref": "#/$defs/sha256" },
        "eval_package_sha256": { "$ref": "#/$defs/sha256" },
        "candidates": {
          "oneOf": [
            { "$ref": "#/$defs/calibrationCandidatesV2" },
            { "$ref": "#/$defs/calibrationCandidatesV3" }
          ]
        },
        "repeatable": { "const": true },
        "seed_stable": { "const": true }
      }
    },
    "calibrationCandidatesV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "red",
        "gold",
        "no_lock_failures",
        "no_persistence_failures",
        "corrupt_resets_failures"
      ],
      "properties": {
        "red": { "$ref": "#/$defs/behaviorStatuses" },
        "gold": { "$ref": "#/$defs/behaviorStatuses" },
        "no_lock_failures": {
          "type": "array",
          "prefixItems": [{ "const": "no_oversubscription_concurrent" }],
          "minItems": 1,
          "maxItems": 1
        },
        "no_persistence_failures": {
          "type": "array",
          "prefixItems": [{ "const": "restart_recovery" }],
          "minItems": 1,
          "maxItems": 1
        },
        "corrupt_resets_failures": {
          "type": "array",
          "prefixItems": [{ "const": "corrupt_state_fail_closed" }],
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "calibrationCandidatesV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "red",
        "gold",
        "no_lock_failures",
        "no_persistence_failures",
        "corrupt_resets_failures",
        "broken_release_failures",
        "release_not_persisted_failures"
      ],
      "properties": {
        "red": { "$ref": "#/$defs/behaviorStatuses" },
        "gold": { "$ref": "#/$defs/behaviorStatuses" },
        "no_lock_failures": {
          "type": "array",
          "prefixItems": [{ "const": "no_oversubscription_concurrent" }],
          "minItems": 1,
          "maxItems": 1
        },
        "no_persistence_failures": {
          "type": "array",
          "prefixItems": [{ "const": "restart_recovery" }],
          "minItems": 1,
          "maxItems": 1
        },
        "corrupt_resets_failures": {
          "type": "array",
          "prefixItems": [{ "const": "corrupt_state_fail_closed" }],
          "minItems": 1,
          "maxItems": 1
        },
        "broken_release_failures": {
          "type": "array",
          "prefixItems": [
            { "const": "terminal_transition_idempotency" },
            { "const": "restart_recovery" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "release_not_persisted_failures": {
          "type": "array",
          "prefixItems": [{ "const": "restart_recovery" }],
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "behaviorStatuses": {
      "type": "array",
      "items": { "enum": ["pass", "fail", "error"] },
      "minItems": 8,
      "maxItems": 8
    }
  }
}
