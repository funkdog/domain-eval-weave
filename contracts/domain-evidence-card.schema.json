{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-eval-lab.local/contracts/domain-evidence-card.schema.json",
  "title": "DSH Eval Lab Domain Evidence Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_id",
    "product_id",
    "domain_id",
    "claim_id",
    "statement",
    "applicability",
    "status",
    "source_refs",
    "authority_ref_ids",
    "observation_ref_ids",
    "false_accept_risk",
    "false_reject_risk"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "card_id": { "$ref": "#/$defs/id" },
    "product_id": { "$ref": "#/$defs/id" },
    "domain_id": { "$ref": "#/$defs/id" },
    "claim_id": { "$ref": "#/$defs/id" },
    "statement": { "type": "string", "minLength": 1 },
    "applicability": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["confirmed", "proposed", "unresolved", "conflicted", "observability_gap"]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "authority_ref_ids": { "$ref": "#/$defs/idArray" },
    "observation_ref_ids": { "$ref": "#/$defs/idArray" },
    "false_accept_risk": { "$ref": "#/$defs/risk" },
    "false_reject_risk": { "$ref": "#/$defs/risk" },
    "confirmed_by": { "$ref": "#/$defs/id" },
    "confirmed_at": { "type": "string", "format": "date-time" },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref_ids", "reason"],
      "properties": {
        "source_ref_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packRef": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[^/]+(?:/[^/]+)*$"
    },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "artifact_ref", "digest"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "owner_statement",
            "requirement",
            "product_doc",
            "external_contract",
            "code",
            "test",
            "runtime_observation",
            "domain_knowledge"
          ]
        },
        "artifact_ref": { "$ref": "#/$defs/packRef" },
        "digest": { "$ref": "#/$defs/sha256" },
        "locator": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
