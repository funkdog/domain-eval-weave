{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-eval-lab.local/contracts/domain-pack-manifest.schema.json",
  "title": "DSH Eval Lab Domain Pack Snapshot Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "product_id",
    "contract",
    "interviews",
    "evidence_cards",
    "confirmations",
    "decision_questions",
    "requirements",
    "graph",
    "readiness_request",
    "readiness_report"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_id": { "$ref": "#/$defs/id" },
    "product_id": { "$ref": "#/$defs/id" },
    "contract": { "$ref": "#/$defs/pointer" },
    "interviews": { "$ref": "#/$defs/pointers" },
    "evidence_cards": { "$ref": "#/$defs/pointers" },
    "confirmations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/confirmationPointer" }
    },
    "decision_questions": { "$ref": "#/$defs/pointers" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pointer" }
    },
    "graph": { "$ref": "#/$defs/pointer" },
    "readiness_request": { "$ref": "#/$defs/pointer" },
    "readiness_report": { "$ref": "#/$defs/pointer" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packRef": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[^/]+(?:/[^/]+)*$"
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": { "ref": { "$ref": "#/$defs/packRef" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "pointers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pointer" }
    },
    "confirmationPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation_id", "sha256"],
      "properties": {
        "confirmation_id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
