{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "template_id": {
      "type": "string",
      "const": "commerce-order-cancellation-v2"
    },
    "compiler": {
      "type": "object",
      "properties": {
        "compiler_id": {
          "type": "string",
          "const": "phase3b2-commerce-compiler"
        },
        "compiler_version": {
          "type": "number",
          "const": 1
        }
      },
      "required": ["compiler_id", "compiler_version"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "domain_manifest": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["ref", "sha256"],
          "additionalProperties": false
        },
        "contract": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["ref", "sha256"],
          "additionalProperties": false
        },
        "requirement": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["ref", "sha256"],
          "additionalProperties": false
        },
        "task_pack_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observation_catalog_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "domain_manifest",
        "contract",
        "requirement",
        "task_pack_sha256",
        "observation_catalog_sha256"
      ],
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "requirement_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "product_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      },
      "required": ["requirement_id", "requirement_version", "product_id"],
      "additionalProperties": false
    },
    "claims": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "contract_version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "domain_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "effect": {
            "type": "string",
            "enum": ["uses", "preserves"]
          },
          "axis": {
            "type": "string",
            "enum": ["requirement_delta", "domain_preservation"]
          },
          "statement_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "false_accept_risk": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "false_reject_risk": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "dependencies": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          },
          "observation_bindings": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "behavior_id": {
                  "type": "string",
                  "enum": [
                    "unpaid_cancel_has_no_refund",
                    "paid_unstarted_creates_paid_amount_refund",
                    "handed_off_order_requires_after_sales",
                    "cancellation_and_refund_states_are_separate",
                    "active_fulfillment_enters_pending_withdrawal",
                    "withdrawal_completion_precedes_cancellation",
                    "withdrawal_rejection_preserves_order_and_effects",
                    "withdrawal_failure_is_recoverable_without_effects",
                    "inventory_compensation_is_exactly_once",
                    "coupon_restore_requires_current_eligibility",
                    "customer_ownership_is_enforced",
                    "request_replay_and_conflict_are_idempotent",
                    "restart_recovery_preserves_handoffs_and_audit",
                    "refund_preserves_paid_amount_currency_and_units",
                    "expired_replay_reconciles_or_fails_closed",
                    "audit_and_retention_policy_are_complete"
                  ]
                },
                "entry_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": ["behavior_id", "entry_sha256"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "claim_id",
          "contract_version",
          "domain_id",
          "effect",
          "axis",
          "statement_sha256",
          "false_accept_risk",
          "false_reject_risk",
          "dependencies",
          "observation_bindings"
        ],
        "additionalProperties": false
      }
    },
    "semantic_residual": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "axis": {
            "type": "string",
            "enum": ["requirement_delta", "domain_preservation"]
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "OBSERVATION_BINDING_MISSING",
              "OBSERVATION_TEMPLATE_UNSUPPORTED",
              "PROPOSED_CLAIM_RISK_UNSPECIFIED"
            ]
          }
        },
        "required": ["claim_id", "axis", "reason_code"],
        "additionalProperties": false
      }
    },
    "traceability": {
      "type": "object",
      "properties": {
        "claim_to_behaviors": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "additionalProperties": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "unpaid_cancel_has_no_refund",
                "paid_unstarted_creates_paid_amount_refund",
                "handed_off_order_requires_after_sales",
                "cancellation_and_refund_states_are_separate",
                "active_fulfillment_enters_pending_withdrawal",
                "withdrawal_completion_precedes_cancellation",
                "withdrawal_rejection_preserves_order_and_effects",
                "withdrawal_failure_is_recoverable_without_effects",
                "inventory_compensation_is_exactly_once",
                "coupon_restore_requires_current_eligibility",
                "customer_ownership_is_enforced",
                "request_replay_and_conflict_are_idempotent",
                "restart_recovery_preserves_handoffs_and_audit",
                "refund_preserves_paid_amount_currency_and_units",
                "expired_replay_reconciles_or_fails_closed",
                "audit_and_retention_policy_are_complete"
              ]
            }
          }
        },
        "behavior_to_claims": {
          "type": "object",
          "properties": {
            "unpaid_cancel_has_no_refund": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "paid_unstarted_creates_paid_amount_refund": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "handed_off_order_requires_after_sales": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "cancellation_and_refund_states_are_separate": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "active_fulfillment_enters_pending_withdrawal": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "withdrawal_completion_precedes_cancellation": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "withdrawal_rejection_preserves_order_and_effects": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "withdrawal_failure_is_recoverable_without_effects": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "inventory_compensation_is_exactly_once": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "coupon_restore_requires_current_eligibility": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "customer_ownership_is_enforced": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "request_replay_and_conflict_are_idempotent": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "restart_recovery_preserves_handoffs_and_audit": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "refund_preserves_paid_amount_currency_and_units": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "expired_replay_reconciles_or_fails_closed": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            },
            "audit_and_retention_policy_are_complete": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            }
          },
          "required": [
            "unpaid_cancel_has_no_refund",
            "paid_unstarted_creates_paid_amount_refund",
            "handed_off_order_requires_after_sales",
            "cancellation_and_refund_states_are_separate",
            "active_fulfillment_enters_pending_withdrawal",
            "withdrawal_completion_precedes_cancellation",
            "withdrawal_rejection_preserves_order_and_effects",
            "withdrawal_failure_is_recoverable_without_effects",
            "inventory_compensation_is_exactly_once",
            "coupon_restore_requires_current_eligibility",
            "customer_ownership_is_enforced",
            "request_replay_and_conflict_are_idempotent",
            "restart_recovery_preserves_handoffs_and_audit",
            "refund_preserves_paid_amount_currency_and_units",
            "expired_replay_reconciles_or_fails_closed",
            "audit_and_retention_policy_are_complete"
          ],
          "additionalProperties": false
        }
      },
      "required": ["claim_to_behaviors", "behavior_to_claims"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "template_id",
    "compiler",
    "source",
    "requirement",
    "claims",
    "semantic_residual",
    "traceability"
  ],
  "additionalProperties": false,
  "$id": "https://dsh-eval-lab.local/contracts/commerce-withdrawal/claim-ir.schema.json"
}
