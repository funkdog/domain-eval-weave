{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "owner_statement",
              "requirement",
              "product_doc",
              "external_contract",
              "code",
              "test",
              "runtime_observation",
              "domain_knowledge"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["source_id", "kind", "path"],
        "additionalProperties": false
      }
    },
    "requirements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "evaluators": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "candidates": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "command": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "timeout_ms": {
            "default": 10000,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 120000
          },
          "max_output_bytes": {
            "default": 262144,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 4194304
          }
        },
        "required": ["candidate_id", "path", "command"],
        "additionalProperties": false
      }
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "required": [
    "schema_version",
    "capsule_id",
    "version",
    "title",
    "domain",
    "sources",
    "requirements",
    "evaluators",
    "candidates",
    "cases"
  ],
  "additionalProperties": false,
  "$id": "https://dsh-eval-lab.local/contracts/capsule/capsule-manifest.schema.json"
}
