{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-eval-lab.local/contracts/requirement-change-set.schema.json",
  "title": "DSH Eval Lab Requirement ChangeSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requirement_id",
    "version",
    "product_id",
    "requirement_refs",
    "base_contract",
    "effects",
    "decision_question_ids",
    "status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "requirement_id": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "product_id": { "$ref": "#/$defs/id" },
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "base_contract": { "$ref": "#/$defs/pointer" },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uses", "preserves", "introduces", "modifies", "deprecates", "conflicts_with"],
      "properties": {
        "uses": { "$ref": "#/$defs/claimRefArray" },
        "preserves": { "$ref": "#/$defs/claimRefArray" },
        "introduces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/proposedClaim" }
        },
        "modifies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "proposed", "reason"],
            "properties": {
              "claim": { "$ref": "#/$defs/claimRef" },
              "proposed": { "$ref": "#/$defs/proposedClaim" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "deprecates": { "$ref": "#/$defs/claimRefArray" },
        "conflicts_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "reason", "source_ref_ids"],
            "properties": {
              "claim": { "$ref": "#/$defs/claimRef" },
              "reason": { "type": "string", "minLength": 1 },
              "source_ref_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      }
    },
    "decision_question_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "status": { "enum": ["draft", "owner_confirmed", "withdrawn"] },
    "confirmed_by": { "$ref": "#/$defs/id" },
    "confirmed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packRef": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[^/]+(?:/[^/]+)*$"
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "$ref": "#/$defs/packRef" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "artifact_ref", "digest"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "owner_statement",
            "requirement",
            "product_doc",
            "external_contract",
            "code",
            "test",
            "runtime_observation",
            "domain_knowledge"
          ]
        },
        "artifact_ref": { "$ref": "#/$defs/packRef" },
        "digest": { "$ref": "#/$defs/sha256" },
        "locator": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "claimRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "contract_version"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/id" },
        "contract_version": { "type": "integer", "minimum": 1 }
      }
    },
    "claimRefArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/claimRef" }
    },
    "proposedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "domain_id", "statement", "applicability", "source_ref_ids"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/id" },
        "domain_id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "applicability": { "type": "string", "minLength": 1 },
        "source_ref_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
