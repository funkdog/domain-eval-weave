{
  "name": "@domaineval/dsh-adapter",
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Optional DSH Session and TDD mechanism adapter for @domaineval/weave",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funkdog/domain-eval-weave.git",
    "directory": "packages/dsh-adapter"
  },
  "homepage": "https://github.com/funkdog/domain-eval-weave#readme",
  "bugs": {
    "url": "https://github.com/funkdog/domain-eval-weave/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tdd": {
      "types": "./dist/tdd.d.ts",
      "import": "./dist/tdd.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@domaineval/weave": "workspace:*",
    "zod": "4.4.3"
  }
}
