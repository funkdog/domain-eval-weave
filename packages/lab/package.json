{
  "name": "@dsh-eval/lab",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Provenance-bound domain Capsules and deterministic evaluator engine",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/packages/lab/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capsule": {
      "types": "./dist/types/packages/lab/src/capsule.d.ts",
      "import": "./dist/capsule.js"
    },
    "./evaluator": {
      "types": "./dist/types/packages/lab/src/evaluator.d.ts",
      "import": "./dist/evaluator.js"
    },
    "./harness": {
      "types": "./dist/types/packages/lab/src/harness.d.ts",
      "import": "./dist/harness.js"
    },
    "./cli": {
      "types": "./dist/types/packages/lab/src/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./internal/canonical-json": {
      "types": "./dist/types/packages/lab/src/canonical-json.d.ts",
      "import": "./dist/internal/canonical-json.js"
    },
    "./schemas/*": "./dist/contracts/*.schema.json",
    "./examples/*": "./dist/examples/*"
  },
  "bin": {
    "dsh-eval-capsule": "./bin/dsh-eval-capsule.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
