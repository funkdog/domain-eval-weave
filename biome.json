{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "tests/**/*.ts",
      "legacy/**/*.ts",
      "legacy/**/*.mjs",
      "legacy/**/*.json",
      "legacy/**/package.json",
      "packages/**/*.ts",
      "packages/**/*.mjs",
      "packages/**/package.json",
      "packages/**/schemas/**/*.json",
      "!packages/**/dist",
      "!packages/**/examples/**",
      "scripts/**/*.mjs",
      "scripts/**/*.ts",
      "cleanroom/**/*.json",
      "cleanroom/**/*.mjs",
      "package.json",
      "tsconfig.base.json",
      "tsconfig.public.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
