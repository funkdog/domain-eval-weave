{
  "name": "domain-eval-weave-workspace",
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Workspace for DomainEval Weave public packages and private legacy compatibility",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm build:legacy",
    "build:packages": "pnpm --filter @domaineval/weave build && pnpm --filter @domaineval/dsh-adapter build",
    "build:weave": "pnpm --filter @domaineval/weave build",
    "build:legacy": "pnpm --filter dsh-eval-lab build",
    "check": "pnpm check:public && pnpm check:legacy",
    "check:public": "biome check packages scripts tests cleanroom package.json tsconfig.base.json tsconfig.public.json",
    "check:legacy": "pnpm --filter dsh-eval-lab check",
    "check:fix": "biome check --write packages scripts tests cleanroom legacy",
    "lint": "pnpm lint:public && pnpm lint:legacy",
    "lint:public": "tsc -p tsconfig.public.json",
    "lint:legacy": "pnpm --filter dsh-eval-lab lint",
    "test": "pnpm test:public && pnpm test:legacy",
    "test:public": "node --import tsx --test --test-concurrency=1 packages/weave/tests/unit/*.test.ts packages/weave/tests/contract/*.test.ts packages/weave/tests/e2e/*.test.ts packages/dsh-adapter/tests/unit/*.test.ts packages/dsh-adapter/tests/contract/*.test.ts tests/acceptance/*.test.ts",
    "test:portable": "pnpm test:public",
    "test:legacy": "pnpm --filter dsh-eval-lab test",
    "generate:capsule-schemas": "node --import tsx scripts/generate-capsule-schemas.ts",
    "generate:phase3c-schemas": "pnpm --filter dsh-eval-lab generate:phase3c-schemas",
    "generate:phase3c-task-pack": "pnpm --filter dsh-eval-lab generate:phase3c-task-pack",
    "freeze:phase3c-judges": "pnpm --filter dsh-eval-lab freeze:phase3c-judges",
    "run:phase3c-judge-cohort": "pnpm --filter dsh-eval-lab run:phase3c-judge-cohort",
    "readiness:open-source": "node scripts/open-source-readiness.mjs",
    "cleanroom:materialize": "node scripts/materialize-phase4b-cleanroom.mjs",
    "cleanroom:verify": "node scripts/verify-phase4b-cleanroom.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
