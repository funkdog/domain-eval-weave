{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-eval-lab.local/contracts/claim-observation-catalog.schema.json",
  "title": "DSH Eval Lab Claim Observation Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_version",
    "task_id",
    "oracle_version",
    "template_id",
    "behaviors",
    "counterexamples"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_id": { "const": "reservation-ledger-v1" },
    "catalog_version": { "const": 1 },
    "task_id": { "const": "open-coding-ts-ledger-v1" },
    "oracle_version": { "const": "ledger-oracle-v3" },
    "template_id": { "const": "reservation-ledger-v1" },
    "behaviors": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "prefixItems": [
        { "$ref": "#/$defs/basicReservation" },
        { "$ref": "#/$defs/idempotentReplay" },
        { "$ref": "#/$defs/conflictingReplay" },
        { "$ref": "#/$defs/noOversubscription" },
        { "$ref": "#/$defs/terminalTransition" },
        { "$ref": "#/$defs/restartRecovery" },
        { "$ref": "#/$defs/corruptState" },
        { "$ref": "#/$defs/deterministicSnapshot" }
      ]
    },
    "counterexamples": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/counterexample" }
    }
  },
  "$defs": {
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior_id", "template_id", "statement", "risk_weight"],
      "properties": {
        "behavior_id": { "$ref": "#/$defs/behaviorId" },
        "template_id": { "const": "reservation-ledger-v1" },
        "statement": { "type": "string", "minLength": 1 },
        "risk_weight": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "basicReservation": {
      "allOf": [
        { "$ref": "#/$defs/behavior" },
        { "type": "object", "properties": { "behavior_id": { "const": "basic_reservation" } } }
      ]
    },
    "idempotentReplay": {
      "allOf": [
        { "$ref": "#/$defs/behavior" },
        { "type": "object", "properties": { "behavior_id": { "const": "idempotent_replay" } } }
      ]
    },
    "conflictingReplay": {
      "allOf": [
        { "$ref": "#/$defs/behavior" },
        {
          "type": "object",
          "properties": { "behavior_id": { "const": "conflicting_replay_rejected" } }
        }
      ]
    },
    "noOversubscription": {
      "allOf": [
        { "$ref": "#/$defs/behavior" },
        {
          "type": "object",
          "properties": { "behavior_id": { "const": "no_oversubscription_concurrent" } }
        }
      ]
    },
    "terminalTransition": {
      "allOf": [
        { "$ref": "#/$defs/behavior" },
        {
          "type": "object",
          "properties": { "behavior_id": { "const": "terminal_transition_idempotency" } }
        }
      ]
    },
    "restartRecovery": {
      "allOf": [
        { "$ref": "#/$defs/behavior" },
        { "type": "object", "properties": { "behavior_id": { "const": "restart_recovery" } } }
      ]
    },
    "corruptState": {
      "allOf": [
        { "$ref": "#/$defs/behavior" },
        {
          "type": "object",
          "properties": { "behavior_id": { "const": "corrupt_state_fail_closed" } }
        }
      ]
    },
    "deterministicSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/behavior" },
        { "type": "object", "properties": { "behavior_id": { "const": "deterministic_snapshot" } } }
      ]
    },
    "behaviorId": {
      "enum": [
        "basic_reservation",
        "idempotent_replay",
        "conflicting_replay_rejected",
        "no_oversubscription_concurrent",
        "terminal_transition_idempotency",
        "restart_recovery",
        "corrupt_state_fail_closed",
        "deterministic_snapshot"
      ]
    },
    "counterexample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "expected_failures"],
      "properties": {
        "candidate_id": {
          "enum": [
            "red",
            "mutant-no-lock",
            "mutant-no-persistence",
            "mutant-corrupt-resets",
            "mutant-broken-release",
            "mutant-release-not-persisted"
          ]
        },
        "expected_failures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/behaviorId" }
        }
      }
    }
  }
}
