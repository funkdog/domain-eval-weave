{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "judge_kind": {
      "type": "string",
      "enum": ["semantic", "code_quality"]
    },
    "repeat_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "contract": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["ref", "sha256"],
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["ref", "sha256"],
      "additionalProperties": false
    },
    "input_manifest": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["ref", "sha256"],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["ref", "sha256"],
      "additionalProperties": false
    },
    "model_route": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "reasoning_effort": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      },
      "required": ["provider", "model", "reasoning_effort"],
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "const": "eval-clowder-runner"
    },
    "tool_policy": {
      "type": "string",
      "const": "none"
    },
    "permission_mode": {
      "type": "string",
      "const": "read-only"
    },
    "started_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "judge_kind",
    "repeat_index",
    "contract",
    "prompt",
    "input_manifest",
    "output_schema",
    "model_route",
    "profile",
    "tool_policy",
    "permission_mode",
    "started_at"
  ],
  "additionalProperties": false,
  "$id": "https://dsh-eval-lab.local/contracts/phase3c/judge-run-descriptor.schema.json"
}
