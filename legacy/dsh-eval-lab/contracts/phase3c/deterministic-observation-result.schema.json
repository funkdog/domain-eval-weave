{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 3
    },
    "template_id": {
      "type": "string",
      "const": "commerce-order-cancellation-v3"
    },
    "boundary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_archive": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["ref", "sha256"],
      "additionalProperties": false
    },
    "candidate_tree_sha256_before": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_tree_sha256_after": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "axis": {
            "type": "string",
            "enum": ["requirement_delta", "domain_preservation"]
          },
          "dimension_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "create_order_outcome",
                "cancel_order_outcome",
                "resolve_withdrawal_outcome",
                "mark_refunded_outcome",
                "get_order_outcome",
                "get_audit_outcome",
                "get_retention_outcome",
                "order_status_state",
                "fulfillment_state_state",
                "withdrawal_state_state",
                "refund_status_state",
                "refund_amount_state",
                "currency_state",
                "inventory_reserved_state",
                "coupon_state_state",
                "version_state",
                "order_cancelled_effect",
                "refund_requested_effect",
                "inventory_compensated_effect",
                "coupon_restored_effect",
                "command_rejected_effect",
                "withdrawal_requested_effect",
                "withdrawal_completed_effect",
                "idempotency_conflict_effect",
                "withdrawal_before_cancellation",
                "request_replay_same_as_first",
                "restart_preserves_public_state",
                "retention_window"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "error"]
          },
          "normal_form_ref": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": ["ref", "sha256"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^artifact:\\/\\/campaign\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": ["ref", "sha256"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "observation_id",
          "claim_id",
          "axis",
          "dimension_ids",
          "status",
          "normal_form_ref",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "measurement_validity": {
      "type": "string",
      "enum": ["valid", "invalid"]
    }
  },
  "required": [
    "schema_version",
    "template_id",
    "boundary_sha256",
    "candidate_archive",
    "candidate_tree_sha256_before",
    "candidate_tree_sha256_after",
    "seed",
    "observations",
    "measurement_validity"
  ],
  "additionalProperties": false,
  "$id": "https://dsh-eval-lab.local/contracts/phase3c/deterministic-observation-result.schema.json"
}
