{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-eval-lab.local/contracts/qualification.schema.json",
  "title": "DSH Eval Lab Carrier Qualification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ready",
    "deployment_digest",
    "session_id",
    "common_tool_schema_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "ready": { "const": true },
    "deployment_digest": { "$ref": "#/$defs/sha256" },
    "session_id": { "$ref": "#/$defs/id" },
    "common_tool_schema_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
